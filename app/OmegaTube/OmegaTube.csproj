<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-tizen10.0</TargetFramework>
    <AssemblyName>OmegaTube</AssemblyName>
    <RootNamespace>OmegaTube</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 4x Cortex-A72 runtime tuning: no PGO instrumentation tier (steady UI/stat code is short-lived), no
         background-GC thread (small heap: short blocking gen2 beats a competing 5th thread). -->
    <TieredPGO>false</TieredPGO>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

</Project>
